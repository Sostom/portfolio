{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "@vercel/php"
    },
    {
      "src": "admin/.*.php",
      "use": "@vercel/php"
    }
  ],
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "admin/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "index.php"
    }
  ],
  "env": {
    "APP_ENV": "production"
  }
}